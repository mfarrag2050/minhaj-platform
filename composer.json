{
	"name": "minhaj/minhaj-platform",
	"description": "Minhaj platform WordPress plugin monorepo.",
	"type": "project",
	"license": "proprietary",
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpunit/phpunit": "^11.0",
		"yoast/phpunit-polyfills": "^3.0",
		"brain/monkey": "^2.6"
	},
	"autoload": {
		"psr-4": {
			"Minhaj\\": "plugins/minhaj-core/includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Minhaj\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"phpcs": "phpcs --standard=phpcs.xml.dist",
		"phpcbf": "phpcbf --standard=phpcs.xml.dist",
		"test": [
			"@php-version-check",
			"phpunit"
		],
		"test:82": "docker run --rm -v \"$(pwd):/app\" -w /app php:8.2-cli php vendor/bin/phpunit",
		"php-version-check": "php -r 'if (PHP_VERSION_ID >= 80300) { fwrite(STDERR, \"refusing to run phpunit on PHP \" . PHP_VERSION . \" — the platform targets 8.2. Use `composer test:82` (runs in a php:8.2-cli container) or a native 8.2 interpreter.\\n\"); exit(1); }'"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
